{
  "name": "flatpackwholehome",
  "version": "1.0.0",
  "description": "MODULIV / The Flat Set whole-home flat-pack furniture storefront with Payload CMS 3 and multi-language support",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "i18n:cms": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/i18n/translate-payload.mjs",
    "i18n:cms:apply": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/i18n/translate-payload.mjs --apply",
    "i18n:translate": "node scripts/i18n/translate-messages.mjs",
    "i18n:translate:pages": "node scripts/i18n/translate-messages.mjs --catalog=pages",
    "i18n:translate:policies": "node scripts/i18n/translate-messages.mjs --catalog=policies",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:flatpack": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-flatpack.ts",
    "seed:media": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-media.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-ecommerce": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^8.2.0",
    "graphql": "^16.8.2",
    "jsonwebtoken": "9.0.1",
    "lucide-react": "0.563.0",
    "next": "16.3.3",
    "next-intl": "4.14.1",
    "next-themes": "0.4.6",
    "payload": "3.88.0",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.34.2",
    "sonner": "^1.7.2",
    "stripe": "18.5.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
