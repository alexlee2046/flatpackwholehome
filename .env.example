# Node environment. Set to "production" on deploy — this flips fail-fast
# checks below (PAYLOAD_SECRET, INITIAL_ADMIN_PASSWORD) from a dev fallback
# to a hard startup error when unset.
NODE_ENV=development

# --- Required ---

# Postgres connection string for Payload's db-postgres adapter. Payload needs
# DDL rights: it creates and alters tables for every collection.
#
# On Supabase, use the session-mode pooler or the direct connection (5432).
# Supavisor's transaction pooler (6543) reassigns connections between queries,
# so a prepared statement may not be found in the session it lands on — which
# surfaces as intermittent 500s rather than as a configuration error. Payload's
# own Supabase guide does not mention this. If 6543 is unavoidable, Drizzle's
# answer is `prepare: false`, which means passing pool options through the
# adapter in payload.config.ts rather than only a connection string here.
DATABASE_URL=postgresql://127.0.0.1:5432/flatpackwholehome

# Secret used to sign Payload JWTs/sessions. Required in production (throws
# on boot if missing); falls back to an insecure dev value otherwise.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Email for the admin account payload.config.ts creates on first boot if
# none exists yet.
INITIAL_ADMIN_EMAIL=admin@example.com

# Password for that first-boot admin account. Required in production
# (throws on boot if missing) — never commit a real value here. Only used
# when the admin account is first created; changing it later has no effect
# on an existing account (onInit never overwrites an existing password).
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Site URLs ---

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical URL used for SEO <link rel="canonical"> tags; falls back to
# NEXT_PUBLIC_SITE_URL if unset.
CANONICAL_SITE_URL=http://localhost:3000

# --- Optional ---

# Max size of the Postgres connection pool.
DB_POOL_MAX=20
PAYLOAD_RUN_MIGRATIONS=false
# Overrides where Payload's Media collection stores uploaded files on disk
# (defaults to a path inside the project).
PAYLOAD_MEDIA_DIR=
# Secret query param required by the Payload live-preview route
# (src/app/(app)/next/preview/route.ts).
PREVIEW_SECRET=replace-with-a-random-preview-secret
# Set automatically by Vercel; used as a URL fallback when the
# NEXT_PUBLIC_* URLs above are unset. No need to set this manually.
VERCEL_PROJECT_PRODUCTION_URL=

COMPANY_NAME="The Flat Set"
TWITTER_CREATOR="@theflatset"
TWITTER_SITE="https://theflatset.com"
SITE_NAME="The Flat Set | Your Entire Home. Delivered in 6 Flat Boxes."

# --- Stripe checkout ---

# Safety gate: checkout remains unavailable unless this is explicitly true AND
# all three Stripe values below are present and belong to the same mode.
CHECKOUT_ENABLED=false
# Optional dedicated HMAC secret for unique swatch vouchers. Falls back to PAYLOAD_SECRET.
VOUCHER_SIGNING_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_replace_me
